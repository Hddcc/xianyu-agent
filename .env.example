# ============ 模型配置（必配）============
# 模型 API Key（默认通义千问，通过阿里云百炼平台获取：https://bailian.console.aliyun.com）
API_KEY=your_api_key_here
# 模型 API 地址（OpenAI 兼容接口）
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型名称
MODEL_NAME=qwen-max
# 分类用的模型（可选，默认与 MODEL_NAME 相同；分类高频低难度，建议配便宜模型）
CLASSIFY_MODEL_NAME=

# ============ 闲鱼配置（必配）============
# 闲鱼网页端 Cookie（F12 -> Network -> Fetch/XHR 中获取，需要包含 unb 和 _m_h5_tk 等字段）
COOKIES_STR=your_cookies_here

# ============ 行为开关（可选）============
# 人工接管切换关键词（卖家在会话里发送该词，切换人工/AI）
TOGGLE_KEYWORDS=。
# 模拟人工输入延迟
SIMULATE_HUMAN_TYPING=False
# 技术专家联网搜索（走 DashScope enable_search，模型需支持）
ENABLE_SEARCH=True
# 卖家自述议价底线（会作为议价专家的参考信息）
FLOOR_NOTE=

# ============ 时限与并发（可选）============
# 单条消息处理的最大循环轮数
AGENT_MAX_TURNS=4
# 单条消息处理的总时限（秒）
AGENT_DEADLINE_SECONDS=30
# 组装上下文时保留的最近消息条数（更早的靠会话画像收拢）
MAX_CONTEXT_MESSAGES=20
# 会话空闲多少小时后，下一条消息进来前压缩成会话画像（0 关闭）
IDLE_COMPACT_HOURS=12

# ============ 平台运维（可选，一般保持默认）============
# 人工接管超时自动恢复（秒）
MANUAL_MODE_TIMEOUT=3600
# 消息过期时间（毫秒，超过则丢弃不回复）
MESSAGE_EXPIRE_TIME=300000
# 心跳间隔（秒）
HEARTBEAT_INTERVAL=15
# 心跳超时（秒）
HEARTBEAT_TIMEOUT=5
# Token 刷新间隔（秒）
TOKEN_REFRESH_INTERVAL=3600
# Token 刷新失败重试间隔（秒）
TOKEN_RETRY_INTERVAL=300

# ============ 卖家通知（可选：AI 做不了的事通知你人工介入）============
# 通知渠道：serverchan（Server酱微信推送，最简单） / smtp（邮件） / 留空=不通知
NOTIFY_METHOD=
# Server酱 SendKey（https://sct.ftqq.com 注册，微信扫码拿 SendKey）
SERVERCHAN_SENDKEY=
# 邮件通知（SMTP）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=

# ============ 其他（可选）============
# 日志级别 DEBUG / INFO / WARNING
LOG_LEVEL=INFO
# 终端调试模式下模拟查询的商品ID（可选）
DEV_ITEM_ID=
